PORT=4000
# Local MongoDB (e.g. Docker). For Atlas: mongodb+srv://<user>:<password>@<cluster>/epicenter?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/epicenter
# Long random string: openssl rand -hex 32
JWT_SECRET=
# Browser origins allowed by CORS; comma-separated for several (e.g. the Vercel URL and localhost)
CLIENT_ORIGIN=http://localhost:5173
# Used by simulators for /control and as the seed agent key. Long random string: openssl rand -hex 32
SIM_KEY=
# true runs the simulator inside the API process (used when hosted)
EMBEDDED_SIM=false
SEED_ADMIN_PASSWORD=
SEED_SRE_PASSWORD=
SEED_VIEWER_PASSWORD=
VITE_API_URL=http://localhost:4000
