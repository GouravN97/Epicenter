{
  "name": "epicenter",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time observability with epicenter tracing, chaos lab and incident replay",
  "type": "module",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "server",
    "simulator",
    "client",
    "tools/stress"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w @epicenter/server",
    "dev:client": "npm run dev -w @epicenter/client",
    "sim": "npm run start -w @epicenter/simulator --",
    "stress": "npm run start -w @epicenter/stress --",
    "seed": "npm run seed -w @epicenter/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
